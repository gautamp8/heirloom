# Copy to .env.local and adjust for your machine.

# Postgres connection. Local dev uses pg17 on port 5433 with the heirloom_app role.
DATABASE_URL=postgres://heirloom_app:heirloom_dev@localhost:5433/heirloom

# Superuser connection. Used only by trusted server-side bootstrap and
# auth-discovery code that legitimately needs to look across RLS tables
# before a session exists. Never used to serve user requests.
DATABASE_ADMIN_URL=postgres://USER@localhost:5433/heirloom

# Ollama daemon (defaults to localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434

# Model names pulled via `ollama pull`.
OLLAMA_SYNTHESIS_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# ---------------------------------------------------------------------------
# Provider profile (src/lib/provider). Leave unset for the default `local`
# profile — Ollama on this machine, nothing leaves the device. "Bring your
# own key" is configured in the app's Settings UI, not here.
#
# `hosted-demo` exists only for the public Sagan demo VM: synthesis and
# embeddings run on Azure OpenAI instead of Ollama. Never set this on a
# personal install.
#HEIRLOOM_PROVIDER_PROFILE=hosted-demo
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_CHAT_DEPLOYMENT=
#AZURE_OPENAI_EMBED_DEPLOYMENT=
# Underlying model of the embed deployment (drives the index identity +
# retrieval-floor lookup; defaults to text-embedding-3-small).
#AZURE_OPENAI_EMBED_MODEL=text-embedding-3-small
# Calibration override for the reflection grounding floor. Normal installs
# never set this; the floor is chosen per embedding model in code.
#HEIRLOOM_RETRIEVAL_FLOOR=0.30
# ---------------------------------------------------------------------------

# 32-byte secret used to sign magic-link JWTs.
# In production, generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-32-byte-random-string

# Web Push (VAPID) keys for iOS PWA notifications.
# Generate with: npx web-push generate-vapid-keys --json
# Both keys must be present for /api/notifications/subscribe to work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
