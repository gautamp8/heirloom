# Copy to .env.local and adjust for your machine.

# Postgres connection. Local dev uses pg17 on port 5433 with the heirloom_app role.
DATABASE_URL=postgres://heirloom_app:heirloom_dev@localhost:5433/heirloom

# Superuser connection. Used only by trusted server-side bootstrap and
# auth-discovery code that legitimately needs to look across RLS tables
# before a session exists. Never used to serve user requests.
DATABASE_ADMIN_URL=postgres://USER@localhost:5433/heirloom

# Ollama daemon (defaults to localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434

# Model names pulled via `ollama pull`.
OLLAMA_SYNTHESIS_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# 32-byte secret used to sign magic-link JWTs.
# In production, generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-32-byte-random-string
